# Copy thành frontend/.env nếu cần đổi cấu hình (không bắt buộc khi chạy mặc định)

# Địa chỉ backend mà Vite dev server chuyển tiếp /api và /uploads tới.
# Chỉ cần đổi khi backend chạy ở cổng khác 4000.
# API_PROXY_TARGET=http://localhost:4000

# Đường dẫn API trong trình duyệt. Mặc định /api/v1 (cùng domain với giao diện).
# Chỉ đổi khi deploy frontend và backend ở hai domain khác nhau.
# VITE_API_URL=/api/v1
