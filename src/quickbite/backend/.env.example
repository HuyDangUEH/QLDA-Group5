# Môi trường: development | test | production
NODE_ENV=development
PORT=4000

# Chuỗi kết nối MySQL: mysql://<user>:<mật_khẩu>@<host>:<port>/<database>
# Nếu mật khẩu có ký tự đặc biệt (@ : / # ? &), hãy mã hoá URL (vd: @ -> %40)
DATABASE_URL="mysql://root:your_password@localhost:3306/quickbite"

# Bí mật ký JWT: chuỗi ngẫu nhiên dài ít nhất 32 ký tự
# Tạo bằng lệnh: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change_me_to_a_long_random_string_at_least_32_chars"
JWT_EXPIRES_IN=7d

# Địa chỉ frontend được phép gọi API (CORS), nhiều địa chỉ cách nhau bằng dấu phẩy
CORS_ORIGINS=http://localhost:5173

# Mức log: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Thư mục lưu ảnh tải lên và dung lượng tối đa (MB)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=2

# Số lần thử đăng nhập/đăng ký sai tối đa mỗi 15 phút cho một IP
AUTH_RATE_LIMIT_MAX=10

# Số reverse proxy (nginx, load balancer) đứng trước API. 0 = chạy trực tiếp (máy local).
# Đặt 1 khi có đúng một nginx phía trước. Đặt sai sẽ cho phép giả IP để vượt giới hạn đăng nhập.
TRUST_PROXY=0

# Tên miền https được phép dùng làm ảnh món/quầy, cách nhau bằng dấu phẩy
# (ảnh có sẵn /images/... và ảnh tải lên /uploads/... luôn được phép)
IMAGE_HOSTS=images.unsplash.com

# Trang tài liệu API /api/docs: mặc định bật khi phát triển, tắt khi production. Đặt true/false để ép.
# API_DOCS=true
