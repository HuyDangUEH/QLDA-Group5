# Cấu hình cho bộ test tự động. Copy thành .env.test
# QUAN TRỌNG: database phải KHÁC database phát triển, vì test sẽ xoá dữ liệu trong đó.
# Tên database bắt buộc kết thúc bằng "_test".
NODE_ENV=test
PORT=4001
DATABASE_URL="mysql://root:your_password@localhost:3306/quickbite_test"
JWT_SECRET="test_secret_test_secret_test_secret_123456"
JWT_EXPIRES_IN=1h
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=silent
UPLOAD_DIR=uploads-test
MAX_UPLOAD_MB=2

# Nới giới hạn đăng nhập khi chạy test (nhiều test cố tình đăng nhập sai)
AUTH_RATE_LIMIT_MAX=1000
TRUST_PROXY=0
IMAGE_HOSTS=images.unsplash.com
