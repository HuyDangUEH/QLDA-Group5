# ═══════════════════════════════════════════════════════════════════════
#  QuickBite — mẫu cấu hình PRODUCTION
#  Sao chép thành backend/.env (máy chủ) hoặc nhập từng biến vào
#  Vercel → Project → Settings → Environment Variables (môi trường Production).
#  KHÔNG commit file chứa giá trị thật. Kiểm tra: npm run prod:check -- --env-file=.env.production
# ═══════════════════════════════════════════════════════════════════════

NODE_ENV=production
PORT=4000

# MySQL production. Ví dụ Aiven (bắt buộc SSL — chứng chỉ do CA riêng của Aiven cấp):
#   mysql://<user>:<mật_khẩu>@<host>.aivencloud.com:<cổng>/quickbite?sslaccept=accept_invalid_certs
#   hoặc xác thực đầy đủ: ...?sslaccept=strict&sslcert=<đường dẫn ca.pem tải từ Aiven>
# Ví dụ máy chủ riêng: mysql://quickbite:<mật_khẩu>@localhost:3306/quickbite
# - Không dùng root: tạo user chỉ có quyền trên database quickbite (xem docs/deployment.md mục 1)
# - Mật khẩu có ký tự đặc biệt (@ : / # ? &) phải mã hoá URL (vd @ -> %40)
DATABASE_URL="mysql://quickbite:<mat_khau_manh>@<host>:3306/quickbite?sslaccept=accept_invalid_certs"

# Khoá ký phiên đăng nhập — tạo MỚI cho production, ≥ 64 ký tự:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Đổi khoá này = đăng xuất mọi người dùng.
JWT_SECRET="<chuoi_ngau_nhien_96_ky_tu>"
JWT_EXPIRES_IN=7d

# Địa chỉ frontend (https), nhiều địa chỉ cách nhau dấu phẩy. Không để localhost.
CORS_ORIGINS=https://quickbite.vercel.app

# Số proxy đứng trước API: 1 khi sau nginx hoặc chạy trên Vercel; 0 khi chạy trực tiếp.
TRUST_PROXY=1

LOG_LEVEL=info

# Ảnh tải lên: đường dẫn tuyệt đối, ngoài thư mục code, nằm trong kế hoạch sao lưu.
# (Trên Vercel ổ đĩa không lưu lâu dài → ảnh tải lên có thể mất sau mỗi lần triển khai.)
UPLOAD_DIR=/var/lib/quickbite/uploads
MAX_UPLOAD_MB=2

AUTH_RATE_LIMIT_MAX=10
IMAGE_HOSTS=images.unsplash.com

# Trang /api/docs: để trống = tắt ở production. Chỉ bật (true) khi cần demo.
# API_DOCS=true

# Webhook SePay tự xác nhận chuyển khoản (bỏ trống = chủ quầy tự xác nhận)
SEPAY_WEBHOOK_API_KEY=

# ─── Sao lưu (npm run db:backup) ───
# Thư mục lưu bản sao lưu: ổ khác / thư mục đồng bộ (OneDrive, Google Drive...) để không mất cùng máy chủ
BACKUP_DIR=/var/backups/quickbite
BACKUP_KEEP=14
